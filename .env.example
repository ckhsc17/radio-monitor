# App
# NODE_ENV=development
# LOG_LEVEL=INFO

# Audio input: omit to use microphone, or set path to an audio file
# AUDIO_FILE=/path/to/audio.wav
# MICROPHONE_ID=0

# ASR provider: whisper | voxtral | firered (default: whisper)
# ASR_PROVIDER=whisper

# VAD squelch threshold (0-1, default 0.1; lower for quiet line-in sources)
# SQUELCH_THRESHOLD=0.03

# Optional: scenario/domain text prepended to context for better terminology
# ASR_SCENARIO_PROMPT=本情境為救護無線電勤務。常見用詞：OHCA、GCS、勤務中心。
# ASR_CONTEXT_LIMIT=5

# Required when ASR_PROVIDER=voxtral
# VOXTRAL_API_URL=http://127.0.0.1:8000/transcribe

# Required when ASR_PROVIDER=firered
# FIRERED_ASR_API_URL=http://127.0.0.1:8001/transcribe

# Ollama LLM summarization (optional, requires running Ollama instance)
# OLLAMA_ENABLED=true
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Optional: Hugging Face token (higher rate limits, gated models). Create at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
